<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="067-add-online-showing" author="qoldan">
        <addColumn tableName="advertisements">
            <column name="online_showing" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <modifyDataType tableName="advertisements" columnName="seller_type" newDataType="varchar(32)"/>
    </changeSet>
</databaseChangeLog>
