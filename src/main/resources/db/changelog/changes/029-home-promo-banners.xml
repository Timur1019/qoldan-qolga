<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="029-create-home-promo-banners" author="app">
        <createTable tableName="home_promo_banners">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="pk_home_promo_banners"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="subtitle" type="VARCHAR(500)"/>
            <column name="badge" type="VARCHAR(100)"/>
            <column name="link" type="VARCHAR(500)"/>
            <column name="image_url" type="VARCHAR(500)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
        </createTable>
    </changeSet>

    <changeSet id="029-insert-default-home-promo-banners" author="app">
        <insert tableName="home_promo_banners">
            <column name="id" value="banner-safe-deal"/>
            <column name="title" value="Безопасные сделки на платформе"/>
            <column name="subtitle" value="Советы, как покупать и продавать без риска."/>
            <column name="badge" value="Безопасно"/>
            <column name="link" value="/dashboard/ads"/>
            <column name="sort_order" valueNumeric="0"/>
        </insert>
        <insert tableName="home_promo_banners">
            <column name="id" value="banner-fast-sell"/>
            <column name="title" value="Как продать быстрее"/>
            <column name="subtitle" value="Оформление объявления, фотографии и цена — всё важно."/>
            <column name="badge" value="Быстро"/>
            <column name="link" value="/ads/create"/>
            <column name="sort_order" valueNumeric="1"/>
        </insert>
        <insert tableName="home_promo_banners">
            <column name="id" value="banner-services"/>
            <column name="title" value="Найдите проверенных исполнителей"/>
            <column name="subtitle" value="Лучшие мастера и специалисты рядом с вами."/>
            <column name="badge" value="Услуги"/>
            <column name="link" value="/dashboard/ads"/>
            <column name="sort_order" valueNumeric="2"/>
        </insert>
    </changeSet>
</databaseChangeLog>
