<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="032-create-brands-table" author="qoldan-qolga">
        <createTable tableName="brands">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="brands_pkey"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="name_uz" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name_ru" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_brands_slug"/>
            </column>
            <column name="logo" type="VARCHAR(500)"/>
            <column name="country" type="VARCHAR(100)"/>
            <column name="website" type="VARCHAR(255)"/>
            <column name="sort_order" type="INT" defaultValueNumeric="100"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="is_popular" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="category_ids" type="VARCHAR(500)"/>
            <column name="meta_title_uz" type="VARCHAR(255)"/>
            <column name="meta_title_ru" type="VARCHAR(255)"/>
            <column name="meta_description_uz" type="VARCHAR(500)"/>
            <column name="meta_description_ru" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="032-create-brand-categories-table" author="qoldan-qolga">
        <createTable tableName="brand_categories">
            <column name="brand_id" type="VARCHAR(36)">
                <constraints nullable="false" references="brands(id)" foreignKeyName="fk_brand_categories_brand" deleteCascade="true"/>
            </column>
            <column name="category_id" type="VARCHAR(36)">
                <constraints nullable="false" references="categories(id)" foreignKeyName="fk_brand_categories_category" deleteCascade="true"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="brand_categories" columnNames="brand_id, category_id" constraintName="pk_brand_categories"/>
        <createIndex tableName="brand_categories" indexName="idx_brand_categories_category">
            <column name="category_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="032-add-brand-id-to-advertisements" author="qoldan-qolga">
        <addColumn tableName="advertisements">
            <column name="brand_id" type="VARCHAR(36)"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="advertisements" baseColumnNames="brand_id"
            constraintName="fk_advertisements_brand"
            referencedTableName="brands" referencedColumnNames="id"/>
        <createIndex tableName="advertisements" indexName="idx_advertisements_brand_id">
            <column name="brand_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
