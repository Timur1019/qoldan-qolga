<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="075-create-home-sell-banners" author="qoldan">
        <createTable tableName="home_sell_banners">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="pk_home_sell_banners"/>
            </column>
            <column name="kicker" type="VARCHAR(120)"/>
            <column name="title" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="subtitle" type="VARCHAR(500)"/>
            <column name="cta_text" type="VARCHAR(120)"/>
            <column name="cta_url" type="VARCHAR(500)"/>
            <column name="image_url" type="VARCHAR(500)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
        </createTable>
    </changeSet>

    <changeSet id="075-seed-home-sell-banner" author="qoldan">
        <insert tableName="home_sell_banners">
            <column name="id" value="074a1b2c-3d4e-4f50-a678-90abcdef1234"/>
            <column name="kicker" value="Qoldan Qolga"/>
            <column name="title" value="Продавайте и зарабатывайте"/>
            <column name="subtitle" value="Отзывы повышают доверие и привлекают больше покупателей"/>
            <column name="cta_text" value="Подать объявление"/>
            <column name="cta_url" value="/ads/create"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="sort_order" valueNumeric="0"/>
        </insert>
    </changeSet>
</databaseChangeLog>
